NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://spectrum:spectrum_local_only@localhost:5432/spectrum?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
TWO_FACTOR_CHALLENGE_TTL=5m
TWO_FACTOR_ENCRYPTION_KEY=replace-with-another-independent-32-character-secret
SAFETY_DATA_ENCRYPTION_KEY=replace-with-a-fourth-independent-32-character-secret
CORS_ORIGIN=http://localhost:8081
APP_BASE_URL=http://localhost:8081
API_PUBLIC_URL=http://localhost:4000
# Optional HTTPS email-delivery webhook. Development responses include preview links when omitted.
# EMAIL_WEBHOOK_URL=https://email-worker.example.com/send
# EMAIL_WEBHOOK_SECRET=replace-me
# OAuth audiences configured in the Apple and Google developer consoles.
# APPLE_CLIENT_ID=com.spectrum.dating
# GOOGLE_CLIENT_IDS=ios-client-id,android-client-id,web-client-id
# Set MEDIA_BUCKET in production. Local development stores uploads under MEDIA_LOCAL_DIR.
# MEDIA_BUCKET=spectrum-production-private
MEDIA_LOCAL_DIR=/tmp/spectrum-uploads
AWS_REGION=us-east-1
# Optional trusted-contact delivery integration for missed date check-ins.
# SAFETY_WEBHOOK_URL=https://safety-worker.example.com/alert
# SAFETY_WEBHOOK_SECRET=replace-me
